# Parameters of the fuzz workflow. Pushing a change to this file starts a run.
DURATION_SECONDS=16200
INSTANCES=4
COMPILER=clang
# compiler option sets separated by ';', each mutant is compiled with one of them
CC_OPTS=-O2 -c;-O3 -march=x86-64-v4 -c;-O2 -g -c;-O2 -fexperimental-new-constant-interpreter -c;-Oz -ffast-math -c
# share of mutations done by the custom mutators in the "mix" variant
EXTRA_RATE=0.7
# free text, change it to start another run with the same parameters
RUN_LABEL=custom-weight-and-options-1
